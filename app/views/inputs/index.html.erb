<h1 class="text-center my-4">動画をアップロード</h1>

<% if flash[:notice] %>
  <div class="mt-2 mb-4 p-2 border-2 border-red-500 border-dashed">
    <h2 class="text-red-500 text-center"><%= flash[:notice] %></h2>
  </div>
<% end %>

<% if flash[:output_image_url] %>
<img src="<%= flash[:output_image_url] %>" alt="作業者を選択してください" style="max-width: 30%; height: auto;">
<div class="mt-3">
    <%= form_with url: performances_path, method: :post, local: true do |form| %>
      <%= form.collection_select :performer_id, Performer.all, :id, :name, prompt: "作業者を選択" %>
      <%= hidden_field_tag :video_id, flash[:video_id] %>
      <%= hidden_field_tag :averaged_results_path, flash[:averaged_results_path] %>
      <%= form.submit "決定", class: "btn btn-primary" %>
    <% end %>
  </div>
<% end %>

<div class="d-flex justify-content-center align-items-center vh-100">
  <div id="drop-zone" class="drop-zone border rounded shadow p-5 text-center">
    <p id="drop-zone-text" class="mb-3">動画ファイルをドラッグ＆ドロップするか、クリックして選択してください</p>
    <%= form_with url: inputs_path, local: true, html: { multipart: true, id: "upload-form" } do |form| %>
      <%= form.file_field :video_file, accept: 'video/*', id: "file-input", class: "form-control d-none" %>
      <%= form.submit "アップロード", id: "submit-button", class: "btn btn-success btn-lg mt-3 d-none" %>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const dropZone = document.getElementById("drop-zone");
    const fileInput = document.getElementById("file-input");
    const submitButton = document.getElementById("submit-button");

    // ドラッグ＆ドロップのイベント
    dropZone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropZone.classList.add("drag-over");
    });

    dropZone.addEventListener("dragleave", () => {
      dropZone.classList.remove("drag-over");
    });

    dropZone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropZone.classList.remove("drag-over");

      if (e.dataTransfer.files.length) {
        fileInput.files = e.dataTransfer.files; // ファイルをfileInputにセット
        submitButton.classList.remove("d-none"); // アップロードボタンを表示
      }
    });

    // ドロップゾーンをクリックした場合
    dropZone.addEventListener("click", () => {
      fileInput.click();
    });

    // ファイル選択時のイベント
    fileInput.addEventListener("change", () => {
      if (fileInput.files.length) {
        submitButton.classList.remove("d-none"); // アップロードボタンを表示
      }
    });
  });
</script>

<style>
  /* ドロップゾーンのスタイル */
  .drop-zone {
    width: 100%;
    max-width: 500px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f9fa;
    border: 2px dashed #ced4da;
    cursor: pointer;
    transition: background-color 0.3s, border-color 0.3s;
  }

  .drop-zone:hover {
    background-color: #e9ecef;
    border-color: #17a2b8;
  }

  .drop-zone.drag-over {
    background-color: #d1ecf1;
    border-color: #0c5460;
  }

  .d-none {
    display: none !important;
  }
